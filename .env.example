# Phase 1 is paper-only. There is intentionally no exchange API key setting.
# Jev is optional; without a key, the Jev strategy fails closed and skips.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Runtime
JEV_ARB_DB=data/jev-arb.db
JEV_ARB_ENABLED_VENUES=coinbase,kraken,binance
JEV_ARB_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
JEV_ARB_PAPER_CAPITAL_USD=25000
JEV_ARB_RESERVE_USD=1000
JEV_ARB_CANDIDATE_POLL_MS=250
JEV_ARB_BOOK_RECORD_MS=100
JEV_ARB_JEV_TIMEOUT_MS=450
JEV_ARB_EXCHANGE_LATENCY_MS=75

# Explicit quote conversion assumptions. Change these rather than silently
# treating USD, USDC, and USDT as identical.
JEV_ARB_USD_TO_USD=1.0
JEV_ARB_USDC_TO_USD=1.0
JEV_ARB_USDT_TO_USD=1.0
JEV_ARB_STABLECOIN_EQUIVALENCE_ASSUMED=true


